# Copier ce fichier vers .env. Ne jamais committer .env.
# Ces valeurs sont des placeholders de développement local, pas des secrets de production.

# PostgreSQL (local ou Neon via le marketplace Vercel)
DATABASE_URL=postgresql://notes:notes@127.0.0.1:5432/notes_scolaires

# Secret de session Auth.js. Au moins 32 caractères, valeur fictive ici.
AUTH_SECRET=change-me-minimum-32-characters-long

# Origine canonique (cookies, contrôle d'origine). HTTPS en production.
APP_URL=http://localhost:3000

# Limites de tentatives. Aucun secret : ce sont des plafonds.
# Valeur absente ou hors plage : le défaut du code s'applique.
# Connexion, couple (e-mail, IP). Défaut : 5 essais, fenêtre 900 secondes.
AUTH_RATE_LIMIT_EMAIL_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Connexion, même IP, tous e-mails. Défaut : 30, au-dessus du seuil e-mail
# pour qu'un compte ne bloque pas les autres derrière la même adresse.
AUTH_RATE_LIMIT_IP_MAX=30
# Changement de mot de passe, par compte de session et par IP. Défaut : 5 / 30 / 900 s.
PASSWORD_RATE_LIMIT_MAX=5
PASSWORD_RATE_LIMIT_IP_MAX=30
PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
# POST /api/notes/valider, par utilisateur de session et par IP. Défaut : 30 / 120 / 60 s.
VALIDATION_RATE_LIMIT_MAX=30
VALIDATION_RATE_LIMIT_IP_MAX=120
VALIDATION_RATE_LIMIT_WINDOW_SECONDS=60
